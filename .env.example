# Names only. Copy this file to .env.local and fill in your own values.
# Never commit .env.local, and never paste keys into chat or code.

# Product Hunt developer token (from your Product Hunt API dashboard)
PRODUCT_HUNT_TOKEN=

# Google Gemini API key (Google AI Studio). Gemini Flash is the only AI used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Shared storage (optional locally; needed on Vercel so the cache is shared between visitors).
# Vercel's Upstash Redis integration sets these for you: KV_REST_API_URL and KV_REST_API_TOKEN.
# Upstash's own names also work: UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Without them the app falls back to server memory and says so in "Run details".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
